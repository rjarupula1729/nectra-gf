# ─── GrowFresh backend environment ────────────────────────────
# Copy this file to `.env` and adjust values for your machine.

NODE_ENV=development
PORT=5000

# ─── Postgres ─────────────────────────────────────────────────
# Option A – single connection URL (preferred for cloud / prod)
# DATABASE_URL=postgres://user:password@host:5432/growfresh

# Option B – discrete vars (used when DATABASE_URL is not set)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=growfresh

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins; "*" allows all (dev only).
# In production set this to your mobile app's web origin or admin URL.
CORS_ORIGIN=*

# ─── Ops / admin API ──────────────────────────────────────────
# REQUIRED in production — protects /api/admin/* and PUT /api/orders/:id/status.
# Generate:  openssl rand -hex 24
ADMIN_TOKEN=

# Optional: POST every new order to this webhook (Slack/Discord/Teams incoming
# webhook or your own endpoint) so the ops team gets an instant alert.
NOTIFY_WEBHOOK_URL=

# ─── OTP / SMS ────────────────────────────────────────────────
# console (default) — OTP is logged to server stdout & returned as `devOtp`
#   in the send-otp response (free; for demos and dev).
# msg91 | fast2sms | twilio — real SMS (fill the matching keys below).
SMS_PROVIDER=console

# Fallback demo code accepted by /verify-otp. Defaults to "1234" when
# NODE_ENV!=production; set DEMO_OTP to override, or leave unset in
# production to disable the demo code entirely.
DEMO_OTP=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=          # DLT template id (India)
FAST2SMS_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ─── Payments (Razorpay) ──────────────────────────────────────
# When set, /api/config reports payments:"razorpay" and the web app opens
# Razorpay Checkout instead of the mock UPI animation. Get keys at
# https://dashboard.razorpay.com (test keys start with rzp_test_).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
